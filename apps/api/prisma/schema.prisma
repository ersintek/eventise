generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED_PENDING
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DELETED_PENDING
}

enum OrganizationRole {
  ORGANIZATION_ADMIN
  EVENT_MANAGER
  FIELD_STAFF
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EventPublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}
enum EventRegistrationStatus {
  NOT_OPEN
  OPEN
  CLOSED
}
enum EventPhase {
  PRE_EVENT
  LIVE
  POST_EVENT
  ARCHIVED
}
enum EventVisibility {
  PUBLIC
  LINK_ONLY
  INVITE_ONLY
}
enum RegistrationMode {
  DIRECT
  APPROVAL
  WAITLIST
}
enum RegistrationApplicationStatus {
  SUBMITTED
  PENDING
  ACCEPTED
  WAITLISTED
  REJECTED
}
enum ConsentRecordStatus {
  GRANTED
  WITHDRAWN
}
enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  firstName         String
  lastName          String
  preferredLanguage String   @default("tr")
  emailVerifiedAt   DateTime?
  status            AccountStatus @default(ACTIVE)
  memberships       OrganizationMembership[]
  auditLogs         AuditLog[] @relation("ActorAuditLogs")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Tier {
  id                              String @id @default(cuid())
  key                             String @unique
  name                            String
  maxActiveEvents                 Int
  maxParticipantsPerEvent         Int
  photoStorageLimitBytes          BigInt
  fileStorageLimitBytes           BigInt
  maxPhotosPerEvent               Int
  defaultMaxPhotosPerParticipant  Int
  emailMultiplier                 Int
  allowedFileTypes                String[]
  featureFlags                    Json
  organizations                   Organization[]
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

model Organization {
  id              String @id @default(cuid())
  name            String
  slug            String @unique
  description     String?
  contactEmail    String
  website         String?
  defaultLanguage String @default("tr")
  status          OrganizationStatus @default(ACTIVE)
  announcementApproved Boolean @default(false)
  tierId          String
  tier            Tier @relation(fields: [tierId], references: [id])
  memberships     OrganizationMembership[]
  tierOverride    OrganizationTierOverride?
  auditLogs       AuditLog[]
  usageCounters   UsageCounter[]
  events          Event[]
  forms           Form[]
  formTemplates   FormTemplate[]
  consentDefinitions ConsentDefinition[]
  emailTemplates EmailTemplate[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Event {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title String
  slug String
  summary String?
  description String?
  venueName String?
  venueAddress String?
  startsAt DateTime
  endsAt DateTime
  timezone String @default("Europe/Istanbul")
  capacity Int
  publicationStatus EventPublicationStatus @default(DRAFT)
  registrationStatus EventRegistrationStatus @default(NOT_OPEN)
  phase EventPhase @default(PRE_EVENT)
  visibility EventVisibility @default(PUBLIC)
  registrationMode RegistrationMode @default(DIRECT)
  registrationOpensAt DateTime?
  registrationClosesAt DateTime?
  formId String?
  form Form? @relation(fields: [formId], references: [id], onDelete: SetNull)
  faqs EventFaqItem[]
  registrations EventRegistration[]
  consentRequirements EventConsentRequirement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, slug])
  @@index([organizationId, publicationStatus])
}

model EventFaqItem {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question String
  answer String
  sortOrder Int @default(0)
}

model FormTemplate {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name String
  description String?
  schema Json
  createdAt DateTime @default(now())
}

model Form {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name String
  versions FormVersion[]
  events Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormVersion {
  id String @id @default(cuid())
  formId String
  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  version Int
  schema Json
  publishedAt DateTime?
  registrations EventRegistration[]
  createdAt DateTime @default(now())
  @@unique([formId, version])
}

model EventRegistration {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formVersionId String?
  formVersion FormVersion? @relation(fields: [formVersionId], references: [id], onDelete: SetNull)
  email String
  firstName String
  lastName String
  answers Json
  applicationStatus RegistrationApplicationStatus
  statusHistory RegistrationStatusHistory[]
  consents ConsentRecord[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([eventId, email])
  @@index([eventId, applicationStatus])
}

model RegistrationStatusHistory {
  id String @id @default(cuid())
  registrationId String
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fromStatus RegistrationApplicationStatus?
  toStatus RegistrationApplicationStatus
  actorId String?
  reason String?
  createdAt DateTime @default(now())
}

model ConsentDefinition {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key String
  title String
  versions ConsentVersion[]
  requirements EventConsentRequirement[]
  createdAt DateTime @default(now())
  @@unique([organizationId, key])
}

model ConsentVersion {
  id String @id @default(cuid())
  definitionId String
  definition ConsentDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version Int
  text String
  records ConsentRecord[]
  createdAt DateTime @default(now())
  @@unique([definitionId, version])
}

model EventConsentRequirement {
  eventId String
  definitionId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  definition ConsentDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  required Boolean @default(true)
  @@id([eventId, definitionId])
}

model ConsentRecord {
  id String @id @default(cuid())
  registrationId String
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  consentVersionId String
  consentVersion ConsentVersion @relation(fields: [consentVersionId], references: [id])
  status ConsentRecordStatus @default(GRANTED)
  ipHash String?
  createdAt DateTime @default(now())
  @@unique([registrationId, consentVersionId])
}

model EmailTemplate {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key String
  subject String
  body String
  messages EmailMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, key])
}

model EmailMessage {
  id String @id @default(cuid())
  templateId String?
  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipient String
  subject String
  body String
  status MessageStatus @default(QUEUED)
  scheduledAt DateTime @default(now())
  sentAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@index([status, scheduledAt])
}

model OrganizationMembership {
  id             String @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model OrganizationTierOverride {
  id             String @id @default(cuid())
  organizationId String @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  limits         Json
  expiresAt      DateTime?
  reason         String
  createdAt      DateTime @default(now())
}

model UsageCounter {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  period         String
  value          BigInt @default(0)
  updatedAt      DateTime @updatedAt
  @@unique([organizationId, key, period])
}

model AuditLog {
  id             String @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json
  ipHash         String?
  createdAt      DateTime @default(now())
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model BackgroundJob {
  id           String    @id @default(cuid())
  type         String
  payload      Json
  status       JobStatus @default(PENDING)
  runAt        DateTime  @default(now())
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  lockedAt     DateTime?
  lockedBy     String?
  completedAt  DateTime?
  lastError    String?
  idempotencyKey String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([status, runAt])
}
