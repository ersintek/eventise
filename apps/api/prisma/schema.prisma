generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED_PENDING
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DELETED_PENDING
}

enum OrganizationRole {
  ORGANIZATION_ADMIN
  EVENT_MANAGER
  FIELD_STAFF
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  firstName         String
  lastName          String
  preferredLanguage String   @default("tr")
  emailVerifiedAt   DateTime?
  status            AccountStatus @default(ACTIVE)
  memberships       OrganizationMembership[]
  auditLogs         AuditLog[] @relation("ActorAuditLogs")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Tier {
  id                              String @id @default(cuid())
  key                             String @unique
  name                            String
  maxActiveEvents                 Int
  maxParticipantsPerEvent         Int
  photoStorageLimitBytes          BigInt
  fileStorageLimitBytes           BigInt
  maxPhotosPerEvent               Int
  defaultMaxPhotosPerParticipant  Int
  emailMultiplier                 Int
  allowedFileTypes                String[]
  featureFlags                    Json
  organizations                   Organization[]
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

model Organization {
  id              String @id @default(cuid())
  name            String
  slug            String @unique
  description     String?
  contactEmail    String
  website         String?
  defaultLanguage String @default("tr")
  status          OrganizationStatus @default(ACTIVE)
  announcementApproved Boolean @default(false)
  tierId          String
  tier            Tier @relation(fields: [tierId], references: [id])
  memberships     OrganizationMembership[]
  tierOverride    OrganizationTierOverride?
  auditLogs       AuditLog[]
  usageCounters   UsageCounter[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrganizationMembership {
  id             String @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model OrganizationTierOverride {
  id             String @id @default(cuid())
  organizationId String @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  limits         Json
  expiresAt      DateTime?
  reason         String
  createdAt      DateTime @default(now())
}

model UsageCounter {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  period         String
  value          BigInt @default(0)
  updatedAt      DateTime @updatedAt
  @@unique([organizationId, key, period])
}

model AuditLog {
  id             String @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json
  ipHash         String?
  createdAt      DateTime @default(now())
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model BackgroundJob {
  id           String    @id @default(cuid())
  type         String
  payload      Json
  status       JobStatus @default(PENDING)
  runAt        DateTime  @default(now())
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  lockedAt     DateTime?
  lockedBy     String?
  completedAt  DateTime?
  lastError    String?
  idempotencyKey String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([status, runAt])
}
