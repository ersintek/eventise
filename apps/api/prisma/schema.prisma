generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED_PENDING
}

enum SystemRole {
  USER
  SYSTEM_ADMIN
}

enum PromotionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DELETED_PENDING
}

enum OrganizationRole {
  ORGANIZATION_ADMIN
  EVENT_MANAGER
  FIELD_STAFF
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EventPublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}
enum EventRegistrationStatus {
  NOT_OPEN
  OPEN
  CLOSED
}
enum EventPhase {
  PRE_EVENT
  LIVE
  POST_EVENT
  ARCHIVED
}
enum EventVisibility {
  PUBLIC
  LINK_ONLY
  INVITE_ONLY
}
enum RegistrationMode {
  DIRECT
  APPROVAL
  WAITLIST
}
enum EventFormat {
  OFFLINE
  ONLINE
  HYBRID
}
enum RegistrationApplicationStatus {
  SUBMITTED
  PENDING
  ACCEPTED
  WAITLISTED
  REJECTED
}
enum ConsentRecordStatus {
  GRANTED
  WITHDRAWN
}
enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

enum ScheduledNotificationStatus {
  SCHEDULED
  CANCELLED
  QUEUED
}

enum AttendanceStatus {
  NOT_CONFIRMED
  CHECKED_IN
  NO_SHOW
  MANUALLY_CONFIRMED
}

enum CheckInMethod {
  ACCOUNT
  MAGIC_LINK
  DOOR_REGISTRATION
  STAFF_MANUAL
}

enum GroupingStrategy {
  RANDOM
  BALANCED
  MANUAL
}
enum GameSessionStatus {
  DRAFT
  OPEN
  REVEAL
  COMPLETED
  CLOSED
}
enum AssessmentKind {
  PRE_TEST
  POST_TEST
}
enum MediaAssetStatus {
  PENDING
  ACTIVE
  DELETED
}
enum PhotoModerationStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ResourceKind {
  FILE
  LINK
}
enum CertificateStatus {
  PENDING
  READY
  FAILED
}
enum ReportExportStatus {
  PENDING
  READY
  FAILED
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  firstName         String
  lastName          String
  preferredLanguage String   @default("tr")
  emailNotifications Boolean @default(true)
  partnerEventEmails Boolean @default(false)
  emailVerifiedAt   DateTime?
  status            AccountStatus @default(ACTIVE)
  systemRole        SystemRole @default(USER)
  deletedAt         DateTime?
  deletionScheduledFor DateTime?
  memberships       OrganizationMembership[]
  auditLogs         AuditLog[] @relation("ActorAuditLogs")
  eventRegistrations EventRegistration[]
  notifications InAppNotification[]
  promotionReviews PromotionRequest[] @relation("PromotionReviewer")
  supportGrants SupportAccessGrant[] @relation("SupportAdmin")
  accountSetupTokens AccountSetupToken[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Tier {
  id                              String @id @default(cuid())
  key                             String @unique
  name                            String
  maxActiveEvents                 Int
  maxParticipantsPerEvent         Int
  photoStorageLimitBytes          BigInt
  fileStorageLimitBytes           BigInt
  maxPhotosPerEvent               Int
  defaultMaxPhotosPerParticipant  Int
  emailMultiplier                 Int
  allowedFileTypes                String[]
  featureFlags                    Json
  organizations                   Organization[]
  promotionRequests               PromotionRequest[]
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

model Organization {
  id              String @id @default(cuid())
  name            String
  slug            String @unique
  description     String?
  contactEmail    String
  website         String?
  defaultLanguage String @default("tr")
  status          OrganizationStatus @default(ACTIVE)
  announcementApproved Boolean @default(false)
  deletedAt       DateTime?
  deletionScheduledFor DateTime?
  tierId          String
  tier            Tier @relation(fields: [tierId], references: [id])
  memberships     OrganizationMembership[]
  tierOverride    OrganizationTierOverride?
  auditLogs       AuditLog[]
  usageCounters   UsageCounter[]
  events          Event[]
  forms           Form[]
  formTemplates   FormTemplate[]
  consentDefinitions ConsentDefinition[]
  emailTemplates EmailTemplate[]
  mediaAssets MediaAsset[]
  quotaReservations QuotaReservation[]
  promotionRequests PromotionRequest[]
  supportAccessGrants SupportAccessGrant[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Event {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title String
  slug String
  summary String?
  description String?
  venueName String?
  venueAddress String?
  onlineLink String?
  format EventFormat @default(OFFLINE)
  startsAt DateTime
  endsAt DateTime
  timezone String @default("Europe/Istanbul")
  capacity Int
  publicationStatus EventPublicationStatus @default(DRAFT)
  registrationStatus EventRegistrationStatus @default(NOT_OPEN)
  phase EventPhase @default(PRE_EVENT)
  visibility EventVisibility @default(PUBLIC)
  registrationMode RegistrationMode @default(DIRECT)
  registrationOpensAt DateTime?
  registrationClosesAt DateTime?
  formId String?
  form Form? @relation(fields: [formId], references: [id], onDelete: SetNull)
  faqs EventFaqItem[]
  registrations EventRegistration[]
  consentRequirements EventConsentRequirement[]
  scheduledNotifications ScheduledNotification[]
  checkInAccess EventCheckInAccess?
  featureSettings EventFeatureSetting[]
  attendanceRecords AttendanceRecord[]
  checkInAttempts CheckInAttempt[]
  guestAccessTokens GuestAccessToken[]
  staffAssignments EventStaffAssignment[]
  groups EventGroup[]
  groupingRuns GroupingRun[]
  gameSessions GameSession[]
  assessments Assessment[]
  feedbackForms FeedbackForm[]
  notifications InAppNotification[]
  photos EventPhoto[]
  resources EventResource[]
  certificateTemplates CertificateTemplate[]
  certificates Certificate[]
  reportExports ReportExport[]
  invitations EventInvitation[]
  temporaryModulesClosedAt DateTime?
  deletedAt DateTime?
  deletionScheduledFor DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, slug])
  @@index([organizationId, publicationStatus])
}

model EventFaqItem {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question String
  answer String
  sortOrder Int @default(0)
}

model EventStaffAssignment {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  membershipId String
  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([eventId, membershipId])
  @@index([membershipId])
}

model FormTemplate {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name String
  description String?
  schema Json
  createdAt DateTime @default(now())
}

model Form {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name String
  versions FormVersion[]
  events Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormVersion {
  id String @id @default(cuid())
  formId String
  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  version Int
  schema Json
  publishedAt DateTime?
  registrations EventRegistration[]
  createdAt DateTime @default(now())
  @@unique([formId, version])
}

model EventRegistration {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  formVersionId String?
  formVersion FormVersion? @relation(fields: [formVersionId], references: [id], onDelete: SetNull)
  email String
  firstName String
  lastName String
  answers Json
  applicationStatus RegistrationApplicationStatus
  statusHistory RegistrationStatusHistory[]
  consents ConsentRecord[]
  attendance AttendanceRecord?
  checkInAttempts CheckInAttempt[]
  guestAccessTokens GuestAccessToken[]
  groupMemberships EventGroupMember[]
  gameParticipations GameParticipant[]
  assessmentSubmissions AssessmentSubmission[]
  feedbackSubmissions FeedbackSubmission[]
  uploadedPhotos EventPhoto[]
  certificates Certificate[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([eventId, email])
  @@index([eventId, applicationStatus])
}

model EventInvitation {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email String
  invitedById String
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([eventId, email])
}

model QuotaReservation {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key String
  bytes BigInt
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId, key, expiresAt])
}

model MediaAsset {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storageKey String @unique
  originalName String
  contentType String
  sizeBytes BigInt
  status MediaAssetStatus @default(PENDING)
  checksum String?
  photos EventPhoto[]
  resources EventResource[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, status])
}

model EventPhoto {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assetId String @unique
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploaderRegistrationId String?
  uploaderRegistration EventRegistration? @relation(fields: [uploaderRegistrationId], references: [id], onDelete: SetNull)
  status PhotoModerationStatus @default(PENDING)
  caption String?
  moderatedById String?
  moderatedAt DateTime?
  createdAt DateTime @default(now())
  @@index([eventId, status])
}

model EventResource {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind ResourceKind
  title String
  assetId String?
  asset MediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  externalUrl String?
  visible Boolean @default(true)
  createdAt DateTime @default(now())
}

model CertificateTemplate {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name String
  bodyTemplate String
  certificates Certificate[]
  createdAt DateTime @default(now())
}

model Certificate {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  templateId String
  template CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  verificationCode String @unique
  status CertificateStatus @default(PENDING)
  storageKey String?
  issuedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@unique([registrationId, templateId])
}

model ReportExport {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  format String
  status ReportExportStatus @default(PENDING)
  storageKey String?
  requestedById String
  lastError String?
  createdAt DateTime @default(now())
  completedAt DateTime?
}

model EventGroup {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name String
  sortOrder Int
  members EventGroupMember[]
  createdAt DateTime @default(now())
  @@unique([eventId, name])
}

model EventGroupMember {
  groupId String
  group EventGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  registrationId String
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  @@id([groupId, registrationId])
  @@unique([registrationId])
}

model GroupingRun {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  strategy GroupingStrategy
  requestedGroupCount Int
  metadata Json
  createdById String
  createdAt DateTime @default(now())
}

model GameSession {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gameKey String
  title String
  status GameSessionStatus @default(DRAFT)
  config Json
  participants GameParticipant[]
  responses GameResponse[]
  assignments GameAssignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GameAssignment {
  id String @id @default(cuid())
  sessionId String
  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  registrationId String
  targetRegistrationId String
  prompt String
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([sessionId, registrationId])
}

model GameParticipant {
  sessionId String
  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  registrationId String
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  @@id([sessionId, registrationId])
}

model GameResponse {
  id String @id @default(cuid())
  sessionId String
  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  registrationId String
  promptKey String
  answer String
  createdAt DateTime @default(now())
  @@unique([sessionId, registrationId, promptKey])
}

model Assessment {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind AssessmentKind
  title String
  schema Json
  open Boolean @default(false)
  submissions AssessmentSubmission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssessmentSubmission {
  id String @id @default(cuid())
  assessmentId String
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  registrationId String
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  answers Json
  score Float?
  submittedAt DateTime @default(now())
  @@unique([assessmentId, registrationId])
}

model FeedbackForm {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title String
  schema Json
  open Boolean @default(false)
  submissions FeedbackSubmission[]
  messages ParticipantFeedbackMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeedbackSubmission {
  id String @id @default(cuid())
  formId String
  form FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  registrationId String
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  answers Json
  anonymous Boolean @default(false)
  submittedAt DateTime @default(now())
  @@unique([formId, registrationId])
}

model ParticipantFeedbackMessage {
  id String @id @default(cuid())
  formId String
  form FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  message String
  createdAt DateTime @default(now())
}

model InAppNotification {
  id String @id @default(cuid())
  eventId String?
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt, createdAt])
}

model EventCheckInAccess {
  id String @id @default(cuid())
  eventId String @unique
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  publicToken String @unique
  enabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventFeatureSetting {
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  featureKey String
  enabled Boolean @default(false)
  config Json
  updatedAt DateTime @updatedAt
  @@id([eventId, featureKey])
}

model AttendanceRecord {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String @unique
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  status AttendanceStatus @default(NOT_CONFIRMED)
  method CheckInMethod?
  confirmedAt DateTime?
  confirmedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([eventId, status])
}

model CheckInAttempt {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String?
  registration EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  method CheckInMethod
  successful Boolean
  ipHash String?
  createdAt DateTime @default(now())
  @@index([eventId, createdAt])
}

model GuestAccessToken {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([eventId, expiresAt])
}

model RegistrationStatusHistory {
  id String @id @default(cuid())
  registrationId String
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fromStatus RegistrationApplicationStatus?
  toStatus RegistrationApplicationStatus
  actorId String?
  reason String?
  createdAt DateTime @default(now())
}

model ConsentDefinition {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key String
  title String
  versions ConsentVersion[]
  requirements EventConsentRequirement[]
  createdAt DateTime @default(now())
  @@unique([organizationId, key])
}

model ConsentVersion {
  id String @id @default(cuid())
  definitionId String
  definition ConsentDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version Int
  text String
  records ConsentRecord[]
  createdAt DateTime @default(now())
  @@unique([definitionId, version])
}

model EventConsentRequirement {
  eventId String
  definitionId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  definition ConsentDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  required Boolean @default(true)
  @@id([eventId, definitionId])
}

model ConsentRecord {
  id String @id @default(cuid())
  registrationId String
  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  consentVersionId String
  consentVersion ConsentVersion @relation(fields: [consentVersionId], references: [id])
  status ConsentRecordStatus @default(GRANTED)
  ipHash String?
  createdAt DateTime @default(now())
  @@unique([registrationId, consentVersionId])
}

model EmailTemplate {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key String
  subject String
  body String
  messages EmailMessage[]
  scheduledNotifications ScheduledNotification[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, key])
}

model ScheduledNotification {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateId String
  template EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sendAt DateTime
  status ScheduledNotificationStatus @default(SCHEDULED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([eventId, status, sendAt])
}

model EmailMessage {
  id String @id @default(cuid())
  templateId String?
  template EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipient String
  subject String
  body String
  status MessageStatus @default(QUEUED)
  scheduledAt DateTime @default(now())
  sentAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@index([status, scheduledAt])
}

model OrganizationMembership {
  id             String @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventAssignments EventStaffAssignment[]
  createdAt      DateTime @default(now())
  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model OrganizationTierOverride {
  id             String @id @default(cuid())
  organizationId String @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  limits         Json
  expiresAt      DateTime?
  reason         String
  createdAt      DateTime @default(now())
}

model UsageCounter {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  period         String
  value          BigInt @default(0)
  updatedAt      DateTime @updatedAt
  @@unique([organizationId, key, period])
}

model AuditLog {
  id             String @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json
  ipHash         String?
  createdAt      DateTime @default(now())
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}

model BackgroundJob {
  id           String    @id @default(cuid())
  type         String
  payload      Json
  status       JobStatus @default(PENDING)
  runAt        DateTime  @default(now())
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  lockedAt     DateTime?
  lockedBy     String?
  completedAt  DateTime?
  lastError    String?
  idempotencyKey String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([status, runAt])
}

model PromotionRequest {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedTierId String
  requestedTier Tier @relation(fields: [requestedTierId], references: [id])
  reason String
  status PromotionRequestStatus @default(PENDING)
  reviewedById String?
  reviewedBy User? @relation("PromotionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([status, createdAt])
}

model SupportAccessGrant {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adminId String
  admin User @relation("SupportAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  reason String
  expiresAt DateTime
  revokedAt DateTime?
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId, expiresAt])
}

model AccountSetupToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
